Depends: python3 (>= 3.10), python3-gi, python3-gi-cairo, gir1.2-gtk-4.0, gir1.2-gnomedesktop-4.0 | libgnome-desktop-4-2 | gir1.2-gnomedesktop-3.0 | libgnome-desktop-3-19, python3-rapidfuzz
Recommends: gir1.2-tracker-3.0
